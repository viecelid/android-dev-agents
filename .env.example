# LLM API Keys 
ANTHROPIC_API_KEY=sk-
# OpenRouter API Key https://openrouter.ai/workspaces/default/keys
OPENROUTER_API_KEY=sk-or

# OpenAI API Keys not here in this case just placeholder, because openrouter is used with QWEN 
OPENAI_API_KEY=sk-or-
OPENAI_API_BASE=https://openrouter.ai/api/v1

# ═══ GitHub (Target Repo) ═══
GITHUB_TOKEN=ghp_
GITHUB_REPO=viecelid/MosquitoBuzzV5
GITHUB_PROJECT_NUMBER=5
DEFAULT_BASE_BRANCH=developer

# ═══ Projekte ═══
SOURCE_REPO_PATH=/Users/xxxxx/StudioProjects/Source-MosquitoBuzz
TARGET_REPO_PATH=/Users/xxxxx/StudioProjects/MosquitoBuzzV5

# ═══ Build ═══
BUILD_COMMAND=./gradlew assembleDebug

# ═══ Android App ═══
APP_PACKAGE=ch.ffhs.mosquitobuzz
APP_NAME=MosquitoBuzz
ANDROID_MIN_SDK=31
ANDROID_TARGET_SDK=35
ANDROID_COMPILE_SDK=36

# ═══ Prompts ═══
PROMPTS_DIR=prompts

# ═══ Agent ═══
MAX_RETRIES=3
